// SoC demo program, ACT_SHIFT=0, LOG2_L=8 (generated by code/python/rv32/gen_soc_demo.py)
// address   word      line  source
//                        1  # SoC demo program (generated by code/python/rv32/gen_soc_demo.py) - testbench stimulus.
//                        2  # CONFIG = LOG2_L 8 | ACT_SHIFT 0 << 4 = 0x08
//                        3      .equ  CONFIG_VALUE, 0x8
00000000    20000537     4      lui   x10, 0x20000           # x10 = 0x2000_0000 SC-TPU base
00000004    100005b7     5      lui   x11, 0x10000           # x11 = 0x1000_0000 peripheral base
00000008    00800293     6      addi  x5, x0, CONFIG_VALUE
0000000c    00552423     7      sw    x5, 0x008(x10)         # TPU CONFIG <- LOG2_L | ACT_SHIFT << 4
00000010    00100293     8      addi  x5, x0, 1
00000014    00552023     9      sw    x5, 0x000(x10)         # TPU CTRL <- START
//                       10  poll_done:
00000018    00452303    11      lw    x6, 0x004(x10)         # TPU STATUS: [0] BUSY, [1] DONE
0000001c    00237313    12      andi  x6, x6, 2
00000020    fe030ce3    13      beq   x6, x0, poll_done      # wait for DONE = 1
00000024    00c52383    14      lw    x7, 0x00C(x10)         # TPU RESULT
00000028    00f3f393    15      andi  x7, x7, 0xF            # [3:0] class
0000002c    0075a023    16      sw    x7, 0x000(x11)         # LED <- RESULT
00000030    03038413    17      addi  x8, x7, '0'            # ASCII digit
//                       18  poll_tx1:
00000034    0085a483    19      lw    x9, 0x008(x11)         # UART_STATUS: [0] tx_busy
00000038    0014f493    20      andi  x9, x9, 1
0000003c    fe049ce3    21      bne   x9, x0, poll_tx1
00000040    0085a223    22      sw    x8, 0x004(x11)         # UART_TX <- '0' + RESULT
00000044    00a00413    23      addi  x8, x0, '\n'
//                       24  poll_tx2:
00000048    0085a483    25      lw    x9, 0x008(x11)
0000004c    0014f493    26      andi  x9, x9, 1
00000050    fe049ce3    27      bne   x9, x0, poll_tx2
00000054    0085a223    28      sw    x8, 0x004(x11)         # UART_TX <- '\n'
00000058    01052603    29      lw    x12, 0x010(x10)        # TPU CYCLES (cycles of the last inference)
0000005c    000016b7    30      lui   x13, 0x1               # x13 = 0x1000
00000060    e0c6a023    31      sw    x12, -512(x13)        # [0x0E00] <- CYCLES
00000064    00100293    32      addi  x5, x0, 1
//                       33  tohost_store:
00000068    0055a823    34      sw    x5, 0x010(x11)         # TOHOST <- 1 (pass): testbench stops here
//                       35  halt_loop:
0000006c    0000006f    36      j     halt_loop
//
// symbols:
//   00000008  CONFIG_VALUE
//   00000018  poll_done
//   00000034  poll_tx1
//   00000048  poll_tx2
//   00000068  tohost_store
//   0000006c  halt_loop
